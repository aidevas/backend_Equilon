# Скопировать в переменные Railway (реальные значения НЕ коммитим)

# Транскрипция
OPENAI_API_KEY=

# Почта — Resend HTTP API (Railway блокирует SMTP)
RESEND_API_KEY=

# Адреса (значения задаём только в Railway). EMAIL_FROM — адрес на verified-домене Resend.
EMAIL_FROM=
REPLY_TO=
NOTIFY_EMAIL_1=
NOTIFY_EMAIL_2=

# Прочее
PORT=3000
RATE_LIMIT=10
MAX_FILE_MB=15
MAX_ATTACH_TOTAL_MB=20
DRY_RUN=0
