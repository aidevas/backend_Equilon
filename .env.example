# Скопировать в переменные Railway (реальные значения НЕ коммитим)

# Транскрипция
OPENAI_API_KEY=

# Почта — Zoho Mail API (HTTP, т.к. Railway блокирует SMTP)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Необязательно — если не задано, определяется автоматически по токену:
ZOHO_ACCOUNT_ID=
# DC аккаунта (US по умолчанию):
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_MAIL_HOST=https://mail.zoho.com

# Адреса (значения задаём только в Railway)
EMAIL_FROM=
NOTIFY_EMAIL_1=
NOTIFY_EMAIL_2=

# Прочее
PORT=3000
RATE_LIMIT=10
MAX_FILE_MB=15
MAX_ATTACH_TOTAL_MB=20
DRY_RUN=0
