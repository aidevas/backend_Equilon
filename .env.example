# Скопировать в переменные Railway (реальные значения НЕ коммитим)
# Транскрипция
OPENAI_API_KEY=

# Почта (Zoho SMTP)
ZOHO_USER=
ZOHO_APP_PASSWORD=
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465

# Адреса (значения задаём только в Railway)
EMAIL_FROM=
NOTIFY_EMAIL_1=
NOTIFY_EMAIL_2=

# Прочее
PORT=3000
RATE_LIMIT=10
MAX_FILE_MB=15
MAX_ATTACH_TOTAL_MB=20
DRY_RUN=0
